# For LOCAL development only. Do not commit a populated .env.
MSSQL_SA_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_LOCAL_PASSWORD
# Set in shell for API and dotnet-ef respectively:
# ConnectionStrings__NovaDb=Server=localhost,14333;Database=NovaHaven;User Id=sa;Password=...;TrustServerCertificate=True
# NOVA_DB_CONNECTION=Server=localhost,14333;Database=NovaHaven;User Id=sa;Password=...;TrustServerCertificate=True
# SeedAdmin__Enabled=true (only in ASPNETCORE_ENVIRONMENT=Development)
# SeedAdmin__Email=admin@local.test
# SeedAdmin__Password=REPLACE_WITH_LOCAL_PASSWORD
# Local account email: in Development, confirmation messages are written to the ignored .local/mail-outbox folder.
# Email__PublicWebOrigin=http://localhost:3002
# Optional SMTP (environment variables only; never put credentials in source):
# Email__Smtp__Host=smtp.example.test
# Email__Smtp__Port=587
# Email__Smtp__From=noreply@example.test
# Email__Smtp__UseSsl=true
# Email__Smtp__Username=REPLACE_WITH_SMTP_USER
# Email__Smtp__Password=REPLACE_WITH_SMTP_PASSWORD
# Optional Web Push for non-Development; Development generates and persists a local key under ignored .local/.
# WebPush__Subject=mailto:admin@example.test
# WebPush__PublicKey=REPLACE_WITH_VAPID_PUBLIC_KEY
# WebPush__PrivateKey=REPLACE_WITH_VAPID_PRIVATE_KEY
